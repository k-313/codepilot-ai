# ==============================================================================
# CodePilot AI — Environment Configuration Example
# Copy this file to .env.local for local development. Never commit .env.local!
# ==============================================================================

# Application Port and Base URL
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database Configuration (PostgreSQL)
# Standard connection string for PostgreSQL (Neon, Supabase, Railway, local Postgres, etc.)
# If left empty, CodePilot AI gracefully initializes an embedded PGlite instance for zero-friction local testing.
DATABASE_URL=postgresql://postgres:password@localhost:5432/codepilot_ai

# GitHub Personal Access Token (Optional)
# Public repositories work without a token (60 requests/hr).
# Add a token to increase the rate limit to 5,000 requests/hr.
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# AI Provider Configuration
# Supported providers: "gemini" | "openai" | "mock"
# "mock" is ideal for offline testing, CI, or when no API keys are present.
AI_PROVIDER=gemini

# Google Gemini API Key (Required if AI_PROVIDER=gemini)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
GEMINI_MODEL=gemini-2.5-flash

# OpenAI / OpenAI-Compatible Provider (Required if AI_PROVIDER=openai)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
